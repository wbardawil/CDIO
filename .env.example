# AI-CDIO — Environment Variables
#
# Copy this file to .env.local for local dev, OR paste each KEY=value
# into Vercel Project Settings → Environment Variables for production.
#
# NEVER commit .env.local (it is in .gitignore — keep it that way).
#
# Variables marked REQUIRED block the app from running.
# Variables marked OPTIONAL are observability / rate-limit features
# that no-op if absent — safe to defer past first deploy.

# ---------------------------------------------------------------
# REQUIRED — Clerk auth (practitioner sign-in / sign-up)
# Get from https://dashboard.clerk.com → your-app → API Keys
# ---------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ---------------------------------------------------------------
# REQUIRED — Supabase Postgres + pgvector
# Get from https://supabase.com/dashboard → your-project → Project Settings
# Server-side service-role key MUST be set; never expose to the browser.
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct DB connection (used by scripts/migrate.js, scripts/inspect-db.js).
# Use the Transaction Pooler (port 6543) with IPv4 enabled — not the
# direct connection — for IPv4-only environments (Vercel functions).
# See docs/LOCAL_DEV.md for the IPv4 gotcha.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# ---------------------------------------------------------------
# REQUIRED — Anthropic (Claude Sonnet + Haiku, the AI agents)
# Get from https://console.anthropic.com → API Keys
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------
# REQUIRED — Resend (stakeholder assessment emails)
# Get from https://resend.com → API Keys
# Sender is currently onboarding@resend.dev (testing).
# Production switch to verified-domain sender happens at Phase 1.5 Day 19
# (custom domain decision pending).
# ---------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------
# OPTIONAL — Upstash Redis rate limiting (Phase 1B safety, deferred)
# Without these, the rate limiter no-ops. Recommended before any
# meaningful public traffic on /api/chat or /api/assessments.
# Get from https://console.upstash.com
# ---------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------
# OPTIONAL — Sentry error monitoring (Phase 1B, deferred)
# Without DSN, error reporting no-ops. Get from sentry.io
# ---------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------
# OPTIONAL — Langfuse LLM observability (Phase 1B, deferred)
# Without keys, observability no-ops. Get from langfuse.com
# ---------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------------------------------------------------------------
# OPTIONAL — Stripe billing (Phase 3, future)
# Not used until Phase 3 commercial release.
# ---------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
